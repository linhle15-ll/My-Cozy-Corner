const sentryEnvironment = "PROD";
const appName = "header-footer-html";
const release = "439";

      /*
       * Inject environment variables into window object for client-side access
       *
       * Note: This method is used because import.meta.env and process.env are not
       * reliably available on the client side in production builds. By injecting
       * server-side environment variables into window.__ENV__ during SSR, we ensure
       * client-side code (like Sentry configuration) has access to these values.
       */
      window.__ENV__ = {
        SENTRY_DSN: sentryDsn,
        SENTRY_ENVIRONMENT: sentryEnvironment,
        APP_NAME: appName,
        RELEASE: release,
      };
    })();</script><link rel="stylesheet" href="https://static-assets.cargurus.com/bundles/header-footer-html/header-footer-html-build/footer.qIX0_DTw.css">
